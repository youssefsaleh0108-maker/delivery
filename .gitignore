# Build output
target/
build/
*.jar
*.war

# The config-repo is its own Git repository, not a directory of this one (Section 6).
# infra/bootstrap.ps1 initialises it; in staging/prod it is a real remote the Config Server clones.
/config-repo/

# Local environment credentials
infra/.env
.env
# Per-environment copies: infra/.env.contabo holds the deployed box's real secrets, pulled down so
# they can be read and edited without an SSH session. The wildcard is deliberately broad — a file
# named after an environment is a file full of that environment's credentials, and the two
# .example negations below are the only things that should ever be committed.
.env.*
infra/.env.*
!.env.example
!infra/.env.example
!.env.dev.example
!infra/.env.dev.example

# IDE
.idea/
*.iml
.vscode/
.settings/
.classpath
.project

# Flutter / Dart
clients/**/.dart_tool/
clients/**/build/
clients/**/.flutter-plugins
clients/**/.flutter-plugins-dependencies
clients/**/ios/Pods/
clients/**/android/.gradle/
*.g.dart
*.freezed.dart

# OS
.DS_Store
Thumbs.db

# Logs
*.log
