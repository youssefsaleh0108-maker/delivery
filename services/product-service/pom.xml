<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Standalone: this service builds, versions and releases on its own, with no parent pom.
       Everything the old aggregator supplied is declared below. -->
  <groupId>com.delivery</groupId>
  <artifactId>product-service</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>
  <name>Service :: Product</name>
  <description>Catalog and pricing, product images in MinIO, catalog-change events (Section 7)</description>

  <properties>
    <java.version>17</java.version>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <spring-boot.version>3.5.16</spring-boot.version>
    <spring-cloud.version>2025.0.0</spring-cloud.version>

    <!-- The shared libraries, resolved from GitHub Packages. Bump deliberately:
         nothing rebuilds this service when the platform changes any more. -->
    <delivery.platform.version>0.1.2</delivery.platform.version>
    <!-- platform-storage is versioned on its own. In this repository the storage-backed services
         build against the platform-storage module in the same reactor, so this must match
         platform/platform-storage/pom.xml: a version the reactor does not build is fetched from
         GitHub Packages instead, which this repository's CI has no credentials for. -->
    <delivery.platform-storage.version>0.1.3</delivery.platform-storage.version>

    <!-- Container image coordinates; override per environment in CI. -->
    <image.registry>docker.io</image.registry>
    <image.namespace>youssefsaleh0108</image.namespace>
    <image.name>delivery-${project.artifactId}</image.name>

    <springdoc.version>2.7.0</springdoc.version>
    <zxing.version>3.5.1</zxing.version>
  </properties>

  <!-- GitHub Packages serves the com.delivery:platform-* jars. It requires authentication even for
       public packages, so every developer and every CI job needs a matching <server id="github">
       in settings.xml — see docs/POLYREPO.md. -->
  <repositories>
    <repository>
      <id>github</id>
      <name>GitHub Packages — delivery platform</name>
      <url>https://maven.pkg.github.com/youssefsaleh0108-maker/delivery.platform</url>
      <releases><enabled>true</enabled></releases>
      <snapshots><enabled>true</enabled></snapshots>
    </repository>
  </repositories>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.springframework.cloud</groupId>
        <artifactId>spring-cloud-dependencies</artifactId>
        <version>${spring-cloud.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.delivery</groupId>
        <artifactId>platform-security</artifactId>
        <version>${delivery.platform.version}</version>
      </dependency>
      <dependency>
        <groupId>com.delivery</groupId>
        <artifactId>platform-outbox</artifactId>
        <version>${delivery.platform.version}</version>
      </dependency>
      <dependency>
        <groupId>com.delivery</groupId>
        <artifactId>platform-observability</artifactId>
        <version>${delivery.platform.version}</version>
      </dependency>
      <dependency>
        <groupId>com.delivery</groupId>
        <artifactId>platform-storage</artifactId>
        <version>${delivery.platform-storage.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>

    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-starter-config</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-starter-bus-amqp</artifactId>
    </dependency>
    <!-- Without these, spring.cloud.config.retry.* is inert and a Config Server that is up but not
         yet listening kills this service on boot. Every service that reads config carries the same
         pair for the same reason. -->
    <dependency>
      <groupId>org.springframework.retry</groupId>
      <artifactId>spring-retry</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-aop</artifactId>
    </dependency>

    <dependency>
      <groupId>com.delivery</groupId>
      <artifactId>platform-security</artifactId>
    </dependency>
    <dependency>
      <groupId>com.delivery</groupId>
      <artifactId>platform-outbox</artifactId>
    </dependency>
    <dependency>
      <groupId>com.delivery</groupId>
      <artifactId>platform-observability</artifactId>
    </dependency>
    <dependency>
      <groupId>com.delivery</groupId>
      <artifactId>platform-storage</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>${springdoc.version}</version>
    </dependency>

    <!-- Merchant Blitz's vision provider (ClaudeVisionProvider). Pinned rather than managed: nothing
         in the Spring BOM knows about it, and a model or beta-flag change is a deliberate bump, not
         something a transitive upgrade should decide. The client reads ANTHROPIC_API_KEY from the
         environment; with no key the service runs the deterministic FAKE provider instead. -->
    <dependency>
      <groupId>com.anthropic</groupId>
      <artifactId>anthropic-java</artifactId>
      <version>2.34.0</version>
    </dependency>

    <!-- The QR code on a shop's public page (ShopQrCode).
         Encoding only, and `core` only: the image is written with ImageIO, which is in the JDK, so
         zxing's `javase` module and the AWT-adjacent dependencies behind it stay out of the
         runtime. A QR encoder is a Reed-Solomon codec plus the specification's mask scoring —
         several hundred lines of arithmetic that is either exactly right or silently produces a
         symbol that will not scan off a printed sign, which is not a thing to hand-roll for a
         feature whose whole point is a card on a counter. Pinned, like the Anthropic client: the
         Spring BOM does not manage it. -->
    <dependency>
      <groupId>com.google.zxing</groupId>
      <artifactId>core</artifactId>
      <version>${zxing.version}</version>
    </dependency>

    <!-- Was inherited from the root pom, which applied it to every module without exception. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Decodes the QR code back, in the test that proves a printed sign works
         (ShopQrCodeTest). Test scope, deliberately: the service never reads a QR code, and the
         decoder is a genuinely separate path from the encoder — PNG bytes, luminance, binarise,
         detect, decode — so the test is not the encoder agreeing with itself. -->
    <dependency>
      <groupId>com.google.zxing</groupId>
      <artifactId>javase</artifactId>
      <version>${zxing.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <release>${maven.compiler.release}</release>
          <!-- Spring matches a bean method's parameter against a bean NAME when the type
               alone is ambiguous, and that fallback needs parameter names in the bytecode.
               Nothing here inherits the Spring Boot parent, which would have set this, so
               without it any config class with two beans of one type fails at startup with
               "required a single bean, but N were found". -->
          <parameters>true</parameters>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <version>${spring-boot.version}</version>
        <configuration>
          <image>
            <name>${image.registry}/${image.namespace}/${image.name}:${project.version}</name>
          </image>
          <excludes>
            <exclude>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
            </exclude>
          </excludes>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
