<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Standalone: this service builds, versions and releases on its own, with no parent pom.
       Everything the old aggregator supplied is declared below. -->
  <groupId>com.delivery</groupId>
  <artifactId>config-server</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>
  <name>Service :: Config Server</name>
  <description>Centralised configuration, Git + Vault composite backend (Section 6)</description>

  <properties>
    <java.version>17</java.version>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <spring-boot.version>3.4.5</spring-boot.version>
    <spring-cloud.version>2024.0.1</spring-cloud.version>

    <!-- The shared libraries, resolved from GitHub Packages. Bump deliberately:
         nothing rebuilds this service when the platform changes any more. -->
    <delivery.platform.version>0.1.0-SNAPSHOT</delivery.platform.version>

    <!-- Container image coordinates; override per environment in CI. -->
    <image.registry>docker.io</image.registry>
    <image.namespace>youssefsaleh0108</image.namespace>
    <image.name>delivery-${project.artifactId}</image.name>
  </properties>

  <!-- GitHub Packages serves the com.delivery:platform-* jars. It requires authentication even for
       public packages, so every developer and every CI job needs a matching <server id="github">
       in settings.xml — see docs/POLYREPO.md. -->
  <repositories>
    <repository>
      <id>github</id>
      <name>GitHub Packages — delivery platform</name>
      <url>https://maven.pkg.github.com/youssefsaleh0108-maker/delivery.platform</url>
      <releases><enabled>true</enabled></releases>
      <snapshots><enabled>true</enabled></snapshots>
    </repository>
  </repositories>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.springframework.cloud</groupId>
        <artifactId>spring-cloud-dependencies</artifactId>
        <version>${spring-cloud.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.delivery</groupId>
        <artifactId>platform-observability</artifactId>
        <version>${delivery.platform.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-config-server</artifactId>
    </dependency>

    <!-- REQUIRED for AppRole. spring-cloud-config-server treats spring-vault-core as optional, and
         without it the Vault backend silently falls back to VaultEnvironmentRepository - the REST
         implementation that expects every *client* to present an X-Config-Token header. That is the
         opposite of the Section 6 design, where the server authenticates to Vault itself and
         clients never learn Vault exists. With this on the classpath the factory builds
         SpringVaultEnvironmentRepository instead, which honours `authentication: APPROLE`. -->
    <dependency>
      <groupId>org.springframework.vault</groupId>
      <artifactId>spring-vault-core</artifactId>
    </dependency>

    <!-- Spring Cloud Bus over RabbitMQ: a Git push triggers a refresh event that every config
         client picks up, so business parameters change without a restart (Section 6). -->
    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-starter-bus-amqp</artifactId>
    </dependency>

    <!-- Basic auth between config clients and this server. NOT the Keycloak resource-server
         config: config clients are services, not end users, so platform-security is deliberately
         absent from this module. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>

    <dependency>
      <groupId>com.delivery</groupId>
      <artifactId>platform-observability</artifactId>
    </dependency>

    <!-- Was inherited from the root pom, which applied it to every module without exception. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <release>${maven.compiler.release}</release>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <version>${spring-boot.version}</version>
        <configuration>
          <image>
            <name>${image.registry}/${image.namespace}/${image.name}:${project.version}</name>
          </image>
          <excludes>
            <exclude>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
            </exclude>
          </excludes>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
