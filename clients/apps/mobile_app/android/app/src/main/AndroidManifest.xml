<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Reaching the Gateway and Keycloak. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Fingerprint and face unlock. Gates a session already on this device; nothing is sent. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>
    <!-- Centring the map pickers on the phone. Asked only when a picker's "use my location" runs;
         a shop pin and a delivery door both need street precision, hence FINE alongside COARSE. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <!-- Not required: the pickers fall back to a city view on devices without GPS. -->
    <uses-feature android:name="android.hardware.location.gps" android:required="false"/>

    <application
        android:label="${appLabel}"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config">
        <!-- Google Maps SDK key, filled from local.properties/env by gradle. Empty until the key
             exists; the map surfaces stay on OSM meanwhile. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${googleMapsApiKey}"/>
        <!--
          taskAffinity is EXPLICIT here, and must not be "".

          The Flutter template ships android:taskAffinity="" on MainActivity to blunt
          StrandHogg-style task-affinity hijacking. It is incompatible with AppAuth: an empty
          affinity does not mean "a shared private affinity", it means NO affinity, so two
          activities that both declare "" still do not group into one task.

          AppAuth's AuthorizationManagementActivity is launchMode="singleTask" and depends on
          affinity matching to be found and resumed when the browser redirect returns. With no
          affinity to match, every redirect starts a fresh task, the instance waiting for the
          response is never reached, and AppAuth reports AuthorizationException code 1
          "User cancelled flow" — for a cancellation that never happened.

          Naming the package affinity explicitly puts MainActivity and both AppAuth activities in
          one task, which is what AppAuth is built for, and documents that the blank value was
          removed on purpose rather than lost in a template merge.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity="com.delivery.mobile_app"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!--
          Pinned to the SAME affinity as MainActivity above, so the browser's redirect to
          com.delivery.app://oauth2redirect comes back into the task that is waiting for it.
          Declared here only to set that attribute — the intent-filter carrying the redirect
          scheme still comes from the library's own manifest via the appAuthRedirectScheme
          manifestPlaceholder in build.gradle.kts, which is why this uses tools:replace on the one
          attribute rather than tools:node="replace" on the whole element.
        -->
        <activity
            android:name="net.openid.appauth.RedirectUriReceiverActivity"
            android:taskAffinity="com.delivery.mobile_app"
            tools:replace="android:taskAffinity" />
        <activity
            android:name="net.openid.appauth.AuthorizationManagementActivity"
            android:taskAffinity="com.delivery.mobile_app"
            tools:replace="android:taskAffinity" />

        <!--
            Where a push lands when it names no channel of its own.

            The connector stamps a channel onto every message it sends, so this is the backstop for
            anything that reaches the device another way — a console test send, a future sender, a
            message from before the channel contract existed. Without it those fall to Firebase's
            fcm_fallback_notification_channel, which is what every notification used to land on:
            one bucket the user can only silence wholesale, taking their deliveries with it.

            Order updates is the honest default for a delivery app. The id must match
            NotificationChannels.ORDERS and the connector's CHANNEL_ORDERS.
        -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="youdrop_order_updates" />

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
