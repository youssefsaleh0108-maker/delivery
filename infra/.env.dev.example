# The dev environment on Contabo. Copy to .env on the box and fill in — .env is gitignored.
#
#   cp .env.dev.example .env && nano .env
#   docker compose -f docker-compose.dev.yml --env-file .env up -d

# ---- the box's public address -----------------------------------------------------------------
# THE SINGLE MOST IMPORTANT SETTING HERE. Both values are baked into things clients receive:
# KEYCLOAK_PUBLIC_URL becomes the `iss` claim of every token, and MINIO_PUBLIC_ENDPOINT is what
# presigned image URLs are signed for. Leave either as localhost and the API works from the box
# while every browser and phone fails — login redirects nowhere, images 403.
PUBLIC_HOST=203.0.113.10
KEYCLOAK_PUBLIC_URL=http://203.0.113.10:8180
MINIO_PUBLIC_ENDPOINT=http://203.0.113.10:9010

# Every origin the Flutter clients are served from. Distinct origins to a browser, and a missing
# one blocks every API call with what Dio reports as a connection error rather than anything
# mentioning CORS.
CORS_ALLOWED_ORIGINS=http://203.0.113.10:5010,http://203.0.113.10:5011,http://203.0.113.10:5012

# ---- images -----------------------------------------------------------------------------------
REGISTRY_NS=youssefsaleh0108
# `main` follows the branch. Pin to a sha- tag to hold a known-good build across restarts.
IMAGE_TAG=main

# ---- credentials ------------------------------------------------------------------------------
# Generate each one: openssl rand -base64 24
# These are NOT the dev defaults from docker-compose.yml. This box has a public IP.
POSTGRES_USER=delivery
POSTGRES_PASSWORD=
REDIS_PASSWORD=
RABBITMQ_USER=delivery
RABBITMQ_PASSWORD=
MINIO_ROOT_USER=delivery
MINIO_ROOT_PASSWORD=
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=
CONFIG_SERVER_USER=config
CONFIG_SERVER_PASSWORD=

# The Config Server's own database role. It reads config.config_properties and nothing else.
CONFIG_DB_USER=config_server
CONFIG_DB_PASSWORD=

# Vault runs in dev mode: in-memory, auto-unsealed, everything lost on restart. Fine for a test
# box, and the reason this environment must not hold real credentials.
VAULT_ROOT_TOKEN=
VAULT_ROLE_ID=
VAULT_SECRET_ID=

# ---- MAIL AND SMS (optional — leave EMPTY to send nothing to real people) ----------------------
# Empty means everything goes to the Mailpit sink that runs alongside the stack. Verification
# codes, order mail and every simulated SMS land there and nowhere else, so a tester can register
# with any address or phone number they like and still read what was sent.
#
#   Read it at http://localhost:8025 after: ssh -L 8025:127.0.0.1:8025 <user>@<host>
#
# TO SEND REAL MAIL, fill these in and restart email-connector and sms-connector. SMTP_HOST is the
# switch; the rest only matter once it is set.
#
# 587 with STARTTLS, or 465 with implicit TLS. Do not use 25 to an external relay — it is
# unauthenticated and usually blocked outbound anyway.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_AUTH=
SMTP_STARTTLS=

# The envelope sender, once mail is real. Must be a domain the relay is authorised for, with SPF
# and DKIM set up — otherwise mail is silently spam-filed and the connector still reports success.
EMAIL_FROM=

# Where the dev SMS provider delivers each simulated message. While the sink is in use this is a
# fake address inside Mailpit and does not have to exist. Against a real relay it becomes a real
# send, so point it at a mailbox you own at the same time you set SMTP_HOST.
SMS_TEST_INBOX=

# ---- Core banking ------------------------------------------------------------------------------
# The simulator is not deployed here. Leave these blank until the banking agreement and the bank's
# published API spec exist.
#
# RealBankClient is a DELIBERATE STUB — it refuses every posting and logs why, rather than guessing
# a contract with money involved. Filling these in does NOT make settlement work; the class has to
# be implemented against a real spec first. Until then, orders reach delivery and settlement fails.
REAL_BANK_URL=
REAL_BANK_CLIENT_ID=
REAL_BANK_CLIENT_SECRET=
