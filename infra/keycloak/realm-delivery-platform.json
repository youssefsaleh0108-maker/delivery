    {
      "username": "backoffice",
      "email": "backoffice@dev.local",
      "firstName": "Bailey",
      "lastName": "Backoffice",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "backoffice",
          "temporary": false
        }
      ],
      "realmRoles": [
        "BACKOFFICE"
      ]
    },
    {
      "username": "carrier",
      "enabled": true,
      "emailVerified": true,
      "email": "carrier@delivery.test",
      "firstName": "Cara",
      "lastName": "Carrier",
      "credentials": [
        {
          "type": "password",
          "value": "carrier",
          "temporary": false
        }
      ],
      "realmRoles": [
        "CARRIER"
      ],
      "attributes": {
        "phoneNumber": [
          "+15550100003"
