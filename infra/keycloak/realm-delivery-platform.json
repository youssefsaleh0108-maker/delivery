{
  "realm": "delivery-platform",
  "displayName": "Delivery Platform",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "failureFactor": 10,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "offlineSessionIdleTimeout": 2592000,
  "roles": {
    "realm": [
      {
        "name": "CUSTOMER",
        "description": "Places and tracks orders in the Mobile App."
      },
      {
        "name": "DELIVERY",
        "description": "Delivery rider: delivery queue, route, proof-of-delivery capture."
      },
      {
        "name": "MERCHANT",
        "description": "Manages own catalog and orders through the Merchant Web Portal."
      },
      {
        "name": "BACKOFFICE",
        "description": "Platform administration, monitoring and reconciliation."
      },
      {
        "name": "CARRIER",
        "description": "Staff of a delivery company: administers their own carrier, not the platform."
      },
      {
        "name": "APPLICANT",
        "description": "Applied to sell, carry or deliver and is waiting on a decision. Grants nothing: it exists so a token can say who somebody is without saying they are a merchant yet."
      }
    ]
  },
  "identityProviders": [
    {
      "alias": "google",
      "displayName": "Google",
      "providerId": "google",
      "enabled": false,
      "trustEmail": true,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "linkOnly": false,
      "hideOnLoginPage": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "$(env:GOOGLE_CLIENT_ID)",
        "clientSecret": "$(env:GOOGLE_CLIENT_SECRET)",
        "defaultScope": "openid profile email",
        "prompt": "select_account",
        "syncMode": "IMPORT",
        "useJwksUrl": "true"
      }
    }
  ],
  "identityProviderMappers": [
    {
      "name": "username-from-email",
      "identityProviderAlias": "google",
      "identityProviderMapper": "oidc-username-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "template": "${CLAIM.email}",
        "target": "LOCAL"
      }
    },
    {
      "name": "email",
      "identityProviderAlias": "google",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "claim": "email",
        "user.attribute": "email"
      }
    },
    {
      "name": "first-name",
      "identityProviderAlias": "google",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "claim": "given_name",
        "user.attribute": "firstName"
      }
    },
    {
      "name": "last-name",
      "identityProviderAlias": "google",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "claim": "family_name",
        "user.attribute": "lastName"
      }
    },
    {
      "name": "customer-role",
      "identityProviderAlias": "google",
      "identityProviderMapper": "oidc-hardcoded-role-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "role": "CUSTOMER"
      }
    }
  ],
  "clients": [
    {
      "clientId": "mobile-app",
      "name": "Flutter Mobile App (Customer + Rider)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": [
        "com.delivery.app://oauth2redirect",
        "com.delivery.app://oauth2redirect/*",
        "http://localhost:5012/*",
        "http://127.0.0.1:5012/*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "com.delivery.app://logout##http://localhost:5012/*##http://127.0.0.1:5012/*"
      },
      "protocolMappers": [
        {
          "name": "phone number",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "phoneNumber",
            "claim.name": "phone_number",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true",
            "multivalued": "false",
            "aggregate.attrs": "false"
          }
        },
        {
          "name": "phone number verified",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "phoneNumberVerified",
            "claim.name": "phone_number_verified",
            "jsonType.label": "boolean",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true",
            "multivalued": "false",
            "aggregate.attrs": "false"
          }
        }
      ]
    },
    {
      "clientId": "delivery-portal",
      "name": "Delivery Portal",
      "description": "One Flutter Web app for MERCHANT, CARRIER and BACKOFFICE. Replaces merchant-portal, backoffice-web and carrier-portal. What a user sees is decided by the realm roles in their token, not by which client they signed in with.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": [
        "http://localhost:5010/*",
        "http://127.0.0.1:5010/*",
        "https://portal-dev.youdrop.shop/*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5010/*##http://127.0.0.1:5010/*##https://portal-dev.youdrop.shop/*"
      },
      "protocolMappers": [
        {
          "name": "phone number",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "phoneNumber",
            "claim.name": "phone_number",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true",
            "multivalued": "false",
            "aggregate.attrs": "false"
          }
        },
        {
          "name": "phone number verified",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "phoneNumberVerified",
            "claim.name": "phone_number_verified",
            "jsonType.label": "boolean",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true",
            "multivalued": "false",
            "aggregate.attrs": "false"
          }
        }
      ]
    },
    {
      "clientId": "backend-services",
      "name": "Spring Boot resource servers",
      "description": "Bearer-only. Validates tokens issued to the client applications above; never initiates a login of its own.",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect"
    },
    {
      "clientId": "notifications-manager",
      "name": "Notifications Manager service account",
      "description": "Reads user email and phone attributes so an order event carrying only a Keycloak sub can be turned into an addressed notification. Scoped to view-users and nothing else - a service that needs to read an email address must not be able to write one.",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "secret": "notifications-manager-dev-secret",
      "protocol": "openid-connect"
    },
    {
      "clientId": "onboarding-service",
      "name": "Onboarding Service service account",
      "description": "Sends verification codes and applicant notifications through Notifications Manager. Its /direct endpoint requires BACKOFFICE, so this service account carries that role — the widest grant on the platform, held by the one service that must message people who have no account yet.",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "secret": "onboarding-service-dev-secret",
      "protocol": "openid-connect"
    },
    {
      "clientId": "accounting-service",
      "name": "Accounting Service service account",
      "description": "Resolves a Keycloak sub into the bank account that user settles through. Scoped to view-users only: a service that reads a payout account must not be able to write one.",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "secret": "accounting-service-dev-secret",
      "protocol": "openid-connect"
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "name": "declarative-user-profile",
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"email\",\"displayName\":\"${email}\",\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"required\":{\"roles\":[\"user\"]},\"multivalued\":false},{\"name\":\"firstName\",\"displayName\":\"${firstName}\",\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"required\":{\"roles\":[\"user\"]},\"multivalued\":false},{\"name\":\"lastName\",\"displayName\":\"${lastName}\",\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"required\":{\"roles\":[\"user\"]},\"multivalued\":false},{\"name\":\"phoneNumber\",\"displayName\":\"Mobile number\",\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"validations\":{\"pattern\":{\"pattern\":\"^\\\\+[1-9]\\\\d{7,14}$\",\"error-message\":\"Must be an E.164 number, e.g. +15550100001\"}},\"multivalued\":false},{\"name\":\"phoneNumberVerified\",\"displayName\":\"Mobile number verified\",\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"validations\":{\"options\":{\"options\":[\"true\",\"false\"]}},\"multivalued\":false},{\"name\":\"fcmToken\",\"displayName\":\"Push device token\",\"permissions\":{\"view\":[\"admin\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"bankAccountRef\",\"displayName\":\"Settlement account\",\"permissions\":{\"view\":[\"admin\"],\"edit\":[\"admin\"]},\"multivalued\":false}],\"groups\":[{\"name\":\"user-metadata\",\"displayHeader\":\"User metadata\",\"displayDescription\":\"Attributes the platform keeps about a person\"}]}"
          ]
        }
      }
    ]
  },
  "clientScopeMappings": {
    "realm-management": [
      {
        "client": "notifications-manager",
        "roles": [
          "view-users"
        ]
      },
      {
        "client": "accounting-service",
        "roles": [
          "view-users"
        ]
      },
      {
        "client": "onboarding-service",
        "roles": [
          "manage-users",
          "view-realm"
        ]
      }
    ]
  },
  "users": [
    {
      "username": "service-account-onboarding-service",
      "enabled": true,
      "serviceAccountClientId": "onboarding-service",
      "realmRoles": [
        "BACKOFFICE"
      ],
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-realm"
        ]
      }
    },
    {
      "username": "service-account-accounting-service",
      "enabled": true,
      "serviceAccountClientId": "accounting-service",
      "clientRoles": {
        "realm-management": [
          "view-users"
        ]
      }
    },
    {
      "username": "service-account-notifications-manager",
      "enabled": true,
      "serviceAccountClientId": "notifications-manager",
      "clientRoles": {
        "realm-management": [
          "view-users"
        ]
      }
    },
