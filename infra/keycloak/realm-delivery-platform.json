      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "merchant",
          "temporary": false
        }
      ],
      "realmRoles": [
        "MERCHANT"
      ],
      "attributes": {
        "phoneNumber": [
          "+15550100003"
        ],
