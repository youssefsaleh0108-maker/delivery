          "dev-fcm-token-merchant-0000000000000000000000000000"
        ],
        "bankAccountRef": [
          "ACC-MERCHANT"
        ]
      }
    }
  ],
  "loginTheme": "delivery",
  "accountTheme": "keycloak.v3",
  "internationalizationEnabled": true,
  "supportedLocales": [
    "en",
    "ar"
  ],
  "defaultLocale": "en"
}
