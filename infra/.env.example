# Copy to infra/.env before the first `docker compose up`.
#
# Every value here is a LOCAL DEVELOPMENT credential. None of it is a secret in any meaningful
# sense and none of it should ever appear in staging or production, where these come from Vault
# via the Config Server (Section 6). infra/.env is gitignored.

# ---- Postgres ----
POSTGRES_USER=delivery
POSTGRES_PASSWORD=delivery

# ---- Redis ----
REDIS_PASSWORD=delivery

# ---- RabbitMQ ----
RABBITMQ_USER=delivery
RABBITMQ_PASSWORD=delivery

# ---- MinIO ----
MINIO_ROOT_USER=delivery
MINIO_ROOT_PASSWORD=delivery123

# The address CLIENTS use to reach MinIO. Presigned upload/download URLs are signed against it, and
# the signature covers the host - so this has to be reachable from the browser or device, and
# rewriting the URL afterwards invalidates it. Use the same host as KEYCLOAK_PUBLIC_URL.
MINIO_PUBLIC_ENDPOINT=http://localhost:9010

# ---- Keycloak ----
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# The address CLIENTS use to reach Keycloak. Becomes the `iss` claim in every token, so it must be
# reachable from whatever is signing in.
#
#   Desktop browsers only .......... http://localhost:8180
#   Android emulator ............... http://10.0.2.2:8180
#   PHYSICAL PHONE on your Wi-Fi ... http://<your-LAN-IP>:8180
#
# A LAN IP works for all three at once, which is why it is the recommended setting when any device
# testing is happening. Re-run `docker compose up -d` after changing it, and remember DHCP can move
# the IP between sessions.
KEYCLOAK_PUBLIC_URL=http://localhost:8180

# ---- Vault (dev mode) ----
VAULT_ROOT_TOKEN=delivery-root-token
# Pinned so compose can pass the Config Server its AppRole credentials directly. Generated
# per-deployment in real environments - see infra/vault/bootstrap.sh.
VAULT_ROLE_ID=config-server-dev-role-id
VAULT_SECRET_ID=config-server-dev-secret-id

# ---- Config Server ----
CONFIG_SERVER_USER=config
CONFIG_SERVER_PASSWORD=local-config-secret
